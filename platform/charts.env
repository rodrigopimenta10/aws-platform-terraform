# Single source of truth for chart versions. smoke-test.sh and tests/lint.sh both read this file.
# Pinned on purpose: a chart that moves under you changes the cluster without a commit.
# Bump one line, run ./smoke-test.sh, commit.
LBC_CHART_REPO=https://aws.github.io/eks-charts
LBC_CHART=eks/aws-load-balancer-controller
LBC_CHART_VERSION=1.13.0

METRICS_SERVER_CHART_REPO=https://kubernetes-sigs.github.io/metrics-server/
METRICS_SERVER_CHART=metrics-server/metrics-server
METRICS_SERVER_CHART_VERSION=3.12.2

EXTERNAL_DNS_CHART_REPO=https://kubernetes-sigs.github.io/external-dns/
EXTERNAL_DNS_CHART=external-dns/external-dns
EXTERNAL_DNS_CHART_VERSION=1.16.1

# Argo CD itself is installed with Helm once (by hand or by Terraform); after that it manages the rest.
ARGOCD_CHART_REPO=https://argoproj.github.io/argo-helm
ARGOCD_CHART=argo/argo-cd
ARGOCD_CHART_VERSION=7.8.2
